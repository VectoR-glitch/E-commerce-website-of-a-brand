# ── Postgres (Neon — pick a Mumbai/Singapore region) ─────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Razorpay (added in Phase 2) ──────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Resend (added in Phase 2) ────────────────────────────────────────────
RESEND_API_KEY=""
# Sender for all transactional email. MUST be an address on a domain you've
# verified in Resend — the code falls back to Resend's "onboarding@resend.dev"
# sandbox sender, which will NOT deliver real customer email in production.
RESEND_FROM="Klenich <orders@klenich.com>"
# Where staff order-notification emails go. Falls back to a dev address if unset.
ADMIN_EMAIL="klenichofficial@gmail.com"

# ── Auth (admin/account login) ───────────────────────────────────────────
# HMAC secret that signs session cookies. Generate a 32+ byte random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates all existing sessions (everyone is logged out).
AUTH_SECRET=""

# ── Cron (subscribe & save reminders) ────────────────────────────────────
# Shared secret for the daily reminder cron (see vercel.json → /api/cron/
# subscription-reminders). Vercel Cron automatically sends this as
# `Authorization: Bearer <CRON_SECRET>`; the route refuses to run unless it's
# set, so define it in the Vercel project env. Generate a random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin for absolute URLs (JSON-LD, OG, emails). No trailing slash.
# Defaults to https://klenich.com; override per environment (e.g. staging).
NEXT_PUBLIC_SITE_URL="https://klenich.com"

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────
# Required in production: without these the limiter falls back to in-memory,
# which does NOT work across Vercel's serverless instances (each gets its own).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Shiprocket (live delivery rates + serviceability) ────────────────────
# Create a DEDICATED API user under Settings → API → Configure, not your login.
# If unset, checkout falls back to the flat state-based delivery rate.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
# Kill-switch: set to "true" to PAUSE the integration (use flat state rate and
# skip live quotes) while keeping all the code. Remove/blank to re-enable.
SHIPROCKET_PAUSED="true"