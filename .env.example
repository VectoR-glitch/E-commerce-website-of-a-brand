# ── Postgres (Neon — pick a Mumbai/Singapore region) ─────────────────────
# DATABASE_URL: the app's RUNTIME connection — use Neon's POOLED (PgBouncer)
# string (hostname has "-pooler" in it). Every serverless invocation opens its
# own connection, so an unpooled string exhausts Neon's direct-connection
# limit under real traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# DIRECT_URL: Neon's DIRECT (non-pooled) string, used only by `prisma migrate`/
# `studio` — DDL isn't safe over a transaction-pooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Razorpay (added in Phase 2) ──────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Resend (added in Phase 2) ────────────────────────────────────────────
RESEND_API_KEY=""
# Sender for all transactional email. MUST be an address on a domain you've
# verified in Resend — the code falls back to Resend's "onboarding@resend.dev"
# sandbox sender, which will NOT deliver real customer email in production.
RESEND_FROM="Klenich <orders@klenich.com>"
# Where staff order-notification emails go. Falls back to a dev address if unset.
ADMIN_EMAIL="klenichofficial@gmail.com"

# ── Auth (admin/account login) ───────────────────────────────────────────
# HMAC secret that signs session cookies. Generate a 32+ byte random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates all existing sessions (everyone is logged out).
AUTH_SECRET=""

# ── Cron (subscribe & save reminders) ────────────────────────────────────
# Shared secret for the daily reminder cron (see vercel.json → /api/cron/
# subscription-reminders). Vercel Cron automatically sends this as
# `Authorization: Bearer <CRON_SECRET>`; the route refuses to run unless it's
# set, so define it in the Vercel project env. Generate a random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Shared secret for the CRM order export (/api/crm-sync/orders). The internal
# klenich-crm app sends this as `Authorization: Bearer <CRM_EXPORT_SECRET>`.
CRM_EXPORT_SECRET=""

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin for absolute URLs (JSON-LD, OG, emails). No trailing slash.
# Defaults to https://klenich.com; override per environment (e.g. staging).
NEXT_PUBLIC_SITE_URL="https://klenich.com"

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────
# Required in production: without these the limiter falls back to in-memory,
# which does NOT work across Vercel's serverless instances (each gets its own).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Shiprocket (live delivery rates + serviceability) ────────────────────
# Create a DEDICATED API user under Settings → API → Configure, not your login.
# If unset, checkout falls back to the flat state-based delivery rate.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
# Kill-switch: set to "true" to PAUSE the integration (use flat state rate and
# skip live quotes) while keeping all the code. Remove/blank to re-enable.
SHIPROCKET_PAUSED="true"

# ── Ekart Logistics (direct integration, replacing Shiprocket) ──────────
# From the Elite dashboard → Settings → API Settings (Client ID) and your
# account login (username/password). Auth exchanges these for a ~24h bearer
# token via POST /integrations/v2/auth/token/{client_id} — no separate static
# API key/secret exists.
EKART_CLIENT_ID=""
EKART_USERNAME=""
EKART_PASSWORD=""
EKART_PICKUP_PINCODE=""
# Kill-switch: set to "true" to PAUSE the integration (use flat state rate,
# skip live quotes/booking) while keeping all the code. Remove/blank to
# re-enable — same shape as SHIPROCKET_PAUSED.
EKART_PAUSED="true"

# ── WhatsApp Cloud API (Meta, direct — no BSP) ───────────────────────────
# From the Meta App's WhatsApp product → API Setup page. The access token
# there is TEMPORARY (24h) — replace with a permanent System User token
# (Business Settings → System Users) before relying on this past testing.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Webhook (…/api/webhooks/whatsapp) — register this URL in the Meta App
# Dashboard under WhatsApp → Configuration, subscribed to the "messages"
# field. WHATSAPP_WEBHOOK_VERIFY_TOKEN is any random string, must match the
# "Verify token" field entered there. WHATSAPP_APP_SECRET is the Meta App's
# App Secret (App Dashboard → Settings → Basic → App Secret) — used to
# verify the X-Hub-Signature-256 header on incoming webhook calls. The
# webhook route fails closed (500) if either is unset.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""