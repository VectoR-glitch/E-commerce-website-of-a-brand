// KLENICH — transactional data (source of truth for price, inventory, orders).
// Marketing content (descriptions, images) lives in Sanity, merged by slug/sku.
// Money is stored in PAISE (integer) to avoid floating-point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A product line (e.g. Floor Cleaner). Marketing content keyed by `slug` in Sanity.
model Product {
  id        String    @id @default(cuid())
  slug      String    @unique // storefront route segment
  name      String
  active    Boolean   @default(true)

  // Marketing/editorial content — moved off the static catalog into the DB so
  // the admin owns it (replaces Sanity). Nullable during migration backfill.
  tagline     String? // short card/PDP line
  claim       String? // tiered, compliance-safe claim
  claimTone   String? // "gentle" | "fresh" | "tough" (drives PDP accent)
  description String? // editorial PDP paragraph
  benefits    String[] @default([]) // bullet list
  howToUse    String[] @default([]) // ordered steps
  safety      String? // caution note (e.g. acidic cleaners)
  placeholder String? // emoji fallback when an image is missing

  variants    Variant[]
  images      ProductImage[]
  reviews     Review[]
  questions   ProductQuestion[]
  bundleItems BundleItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A customer review of a product. Only customers who bought the product may
/// post one (checked server-side), and it stays hidden until an admin approves
/// it — so `approved` gates public visibility. One review per customer/product.
model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  rating     Int // 1–5 stars
  title      String?
  body       String
  approved   Boolean  @default(false) // admin-gated before it shows publicly
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId]) // one review per customer per product
  @@index([productId])
}

/// A product Q&A entry. Two kinds share one model:
///  - Store FAQ (isFaq=true, customerId=null): common questions the brand seeds
///    and answers itself; published immediately.
///  - Customer question (isFaq=false): a signed-in shopper asks — no purchase
///    required, since questions are usually pre-purchase — and it stays hidden
///    until an admin answers it, which publishes it.
/// `published` gates public visibility either way. Ordering: FAQ first by
/// `sortOrder`, then answered customer questions newest-first (see product-qa.ts).
model ProductQuestion {
  id         String    @id @default(cuid())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  // Null for store FAQ, or once an asker deletes their account (SetNull keeps
  // the published Q&A intact — it belongs to the product, not the person).
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  askedName  String? // asker's display name captured at ask time; null for FAQ
  question   String
  answer     String? // the store's answer; null while awaiting a reply
  answeredAt DateTime?
  published  Boolean   @default(false) // admin-gated before it shows publicly
  isFaq      Boolean   @default(false) // store-seeded common Q&A vs customer-asked
  sortOrder  Int       @default(0) // FAQ display order (lower first)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([productId])
}

/// A product image stored directly in Postgres (self-owned, no object storage).
/// `data` holds the binary; it's served via /api/product-image/[id] with
/// immutable caching (a new upload = a new id, so the URL is stable to cache).
/// `fragrance`/`size` scope an image to a specific variant axis (null = the
/// product-level default).
model ProductImage {
  id          String  @id @default(cuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  data        Bytes // the image binary (bytea)
  contentType String // e.g. image/webp
  alt         String?
  fragrance   String? // null = applies regardless of fragrance
  size        String? // null = applies regardless of size
  isPrimary   Boolean @default(false) // the card/PDP default
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

/// A buyable SKU (fragrance + size). Price & stock are the source of truth here.
model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique
  barcode    String?     @unique // EAN-13; null for items without a barcode
  product    Product     @relation(fields: [productId], references: [id])
  productId  String
  fragrance  String? // null when the product has no fragrance axis
  size       String
  pricePaise Int
  stock      Int         @default(0)
  // Packed shipping weight of one unit in grams (bottle + packaging). Nullable
  // means "not yet measured": courier rate calc must treat null as a hard block,
  // never as 0g. Set per-SKU once each bottle is weighed.
  weightGrams Int?
  active     Boolean     @default(true) // inactive variants never show on the site
  orderItems OrderItem[]
  cartItems  CartItem[]
  bundleItems BundleItem[]
  subscriptions Subscription[]
  backInStockAlerts BackInStockAlert[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

/// A "notify me when back in stock" request against a specific out-of-stock
/// variant. One pending request per email+variant (re-subscribing just resets
/// notifiedAt). When the variant is restocked, everyone with notifiedAt = null
/// is emailed and stamped notified — so they're never nudged twice for the same
/// refill, but CAN sign up again if it sells out later. customerId is recorded
/// when a signed-in shopper subscribes (plain reference, no FK — the alert is
/// email-addressed and outlives an account deletion).
model BackInStockAlert {
  id         String    @id @default(cuid())
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId  String
  email      String
  customerId String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([variantId, email])
  @@index([variantId])
  @@index([notifiedAt])
}

/// A curated kit — a set of variants sold together at a discount to cross-sell
/// the range. The saving is realised by a mirrored coupon (code KIT-<slug>) so
/// the whole checkout/settlement/receipt discount pipeline is reused unchanged.
model Bundle {
  id            String       @id @default(cuid())
  slug          String       @unique // storefront + coupon key
  name          String
  description   String?
  active        Boolean      @default(true)
  discountType  DiscountType
  discountValue Int // percent (1–100) or paise off, mirrored into the coupon
  // Optional kit photo stored inline (one per bundle). Served via
  // /api/bundle-image/[id]; queries omit `imageData` so the storefront list
  // never loads the blob. `imageType` (small) signals whether a photo exists.
  imageData     Bytes?
  imageType     String?
  items         BundleItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BundleItem {
  id       String @id @default(cuid())
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String
  // A slot is EITHER an exact variant OR a flexible product slot: any variant of
  // `product`, optionally locked to `size` — the customer picks the specific
  // variant (fragrance/size) when adding the kit. Exactly one of variantId /
  // productId is set (enforced in the admin action).
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?
  size      String? // size lock for a product slot; null = any size
  quantity  Int      @default(1)

  @@index([bundleId])
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  phone     String?
  // Account auth. passwordHash is null for guest/order-only rows (no login);
  // set (scrypt) once a row is an actual login account. role gates the admin
  // ops console — only ADMIN reaches /admin.
  passwordHash String?
  role         Role    @default(CUSTOMER)
  // Set when the customer confirms their email via the verification link.
  // Null = unverified (account created but email not yet confirmed).
  emailVerified DateTime?

  // Loyalty: current redeemable balance (1 point = ₹1, see POINT_VALUE_PAISE).
  // `points` is the running balance; every change is also journalled in
  // LoyaltyLedger for audit. `referralCode` is this customer's own shareable
  // code (generated lazily). `referredById` points at the customer who referred
  // them (self-relation) — set once at registration, drives the referral bonus.
  points        Int     @default(0)
  referralCode  String? @unique
  referredBy    Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referredById  String?
  referrals     Customer[] @relation("Referrals")

  orders    Order[]
  addresses Address[]
  cart      Cart?
  reviews   Review[]
  questions ProductQuestion[]
  subscriptions Subscription[]
  wishlist      WishlistItem[]
  loyaltyLedger LoyaltyLedger[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([referredById])
}

/// A signed-in customer's saved product (cross-device wishlist). Mirrors the
/// server Cart pattern: the guest wishlist lives in localStorage; on login it
/// merges into these rows, which then become authoritative. Keyed on the
/// product SLUG + fragrance (NOT a variant) so it matches the client wishlist's
/// identity — the same product+fragrance a shopper hearts on a card. `fragrance`
/// defaults to "" (never null) so the composite unique constraint actually
/// dedupes fragrance-less products (Postgres treats NULLs as distinct).
model WishlistItem {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  productSlug String
  fragrance   String   @default("")
  createdAt   DateTime @default(now())

  @@unique([customerId, productSlug, fragrance])
  @@index([customerId])
}

/// An append-only journal of every loyalty-point movement, so the running
/// `Customer.points` balance is always reconstructable and auditable. `delta` is
/// positive for points earned, negative for points redeemed. `reason` tags the
/// source ("order" | "referral" | "referee" | "redeem"); `orderId` links an earn
/// back to the order that triggered it (also the idempotency anchor — earn is
/// written exactly once, inside the order's winning settlement claim).
model LoyaltyLedger {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  delta      Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// One-time email-verification tokens (hashed). A customer may have several
// outstanding at once (e.g. after a resend); any unexpired one confirms.
model VerificationToken {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// One-time password-reset tokens (hashed). usedAt marks a token spent so the
// link can't be replayed after a successful reset.
model PasswordResetToken {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// Server-side cart for signed-in customers (cross-device). The guest cart lives
// in localStorage; on login it merges into this, which becomes authoritative.
model Cart {
  id         String     @id @default(cuid())
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String     @unique
  items      CartItem[]
  // When we last emailed an abandoned-cart reminder for this cart. Reset to null
  // on every cart write (see writeCart), so each fresh abandonment episode is
  // eligible for exactly one reminder — never a repeated nudge for the same cart.
  reminderSentAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  quantity  Int

  @@unique([cartId, variantId])
  @@index([cartId])
}

/// An order. All address/price fields are SNAPSHOTTED at checkout so later
/// catalog or address edits never alter a historical order.
model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique // human-friendly, e.g. KLN-2026-0042

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String? // null for guest checkout

  // contact snapshot
  email String
  phone String?

  // shipping snapshot (denormalized on purpose)
  shipName    String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(ONLINE)

  // money, all in paise
  subtotalPaise Int
  shippingPaise Int @default(0)
  discountPaise Int @default(0)
  couponCode    String? // the coupon applied to this order, if any (uppercase)
  totalPaise    Int
  // Loyalty points awarded when this order settled (0 for guest orders / before
  // settlement). Written exactly once inside the winning settlement claim, so it
  // also marks that earn has already been granted for this order.
  pointsEarned  Int @default(0)
  // Amount actually collected via Razorpay. ONLINE = totalPaise; COD = the
  // delivery fee prepaid up front (goods are paid in cash on delivery, so the
  // cash due on delivery = totalPaise - amountPaidPaise).
  amountPaidPaise Int @default(0)

  // Razorpay
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  variant   Variant? @relation(fields: [variantId], references: [id])
  variantId String? // kept nullable so deleting a variant never orphans history

  // snapshot fields — immutable record of what was bought
  sku         String
  productName String
  fragrance   String?
  size        String
  unitPaise   Int
  quantity    Int
  linePaise   Int

  @@index([orderId])
}

/// A discount code applied at checkout. `value` is a percentage (1–100) when
/// type is PERCENT, otherwise a flat amount in paise. usedCount is incremented
/// once per order at payment settlement (idempotent), and maxUses caps it.
model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique // stored uppercase; compared case-insensitively
  type          DiscountType
  value         Int
  minOrderPaise Int          @default(0) // minimum cart subtotal to qualify
  maxUses       Int? // null = unlimited total redemptions
  usedCount     Int          @default(0)
  active        Boolean      @default(true)
  expiresAt     DateTime? // null = never expires
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// A "subscribe & save" standing order. Managed + reminder model (no stored
/// card mandate): we track the schedule and email the customer each cycle with
/// a one-tap reorder that pre-applies their saved discount. The discount is
/// realised through a per-subscription coupon (code SUB-<id-suffix>) so the
/// whole checkout/settlement discount pipeline is reused — same as kits. That
/// code is PRIVATE (only ever shown in the customer's own reminder/account, never
/// in public page source), so its unguessable cuid suffix is sufficient gating.
model Subscription {
  id              String   @id @default(cuid())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  variant         Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId       String
  quantity        Int      @default(1)
  intervalDays    Int // cadence: every N days (e.g. 30 / 45 / 60)
  discountPercent Int // saved % off, snapshotted at subscribe time
  status          SubscriptionStatus @default(ACTIVE)
  nextDeliveryAt  DateTime // when the next reminder/reorder is due
  lastReminderAt  DateTime? // guards against double-sending a cycle's reminder
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status, nextDeliveryAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum Role {
  CUSTOMER // default — a shopper account (or guest order-only row)
  STAFF // reserved for future limited-access staff
  ADMIN // full ops console access
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ON_HOLD // paid, but a stock shortfall at settlement blocks fulfillment — needs staff review/refund
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID // COD: delivery fee prepaid online, goods still due as cash
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE // prepaid via Razorpay
  COD    // delivery fee prepaid via Razorpay; goods collected in cash on delivery
}